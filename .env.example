# ---------------------------------------------------------------------------
# Bytari Mobile — PUBLIC configuration only.
# Copy to `.env` for local development. Everything here ships in the app bundle
# and must be treated as public. NEVER put a secret, API key, or private
# credential in this file or in any EXPO_PUBLIC_* variable.
# ---------------------------------------------------------------------------

# Backend REST API origin (WITHOUT the /api/v1 suffix — the app appends it).
#   iOS simulator : http://localhost:3000
#   Android emu   : http://10.0.2.2:3000
#   physical dev  : http://<your-LAN-ip>:3000
#   production    : https://api.baytari.com   (web image: Docker build args)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_VERSION=v1

# Realtime WebSocket gateway origin (ws:// dev, wss://api.baytari.com prod) + path.
EXPO_PUBLIC_REALTIME_URL=ws://localhost:3000
EXPO_PUBLIC_REALTIME_PATH=/realtime

# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# Network request timeout (ms).
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=20000

# Verbose client logging. Tokens/PII are redacted regardless of this flag.
EXPO_PUBLIC_DEBUG_LOGGING=false

# Public web-app origin used in share links (clinic / office details).
EXPO_PUBLIC_WEB_URL=https://baytari.com

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push) — native only.
# Android reads ./google-services.json (app.json `android.googleServicesFile`);
# no env var needed. The web build has no push. No Firebase secret ever belongs
# in JS/EXPO_PUBLIC_* — the Admin credentials live only on the backend.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Cloudflare R2 — the mobile app holds NO R2 credentials. Uploads use short-lived
# presigned URLs issued by the backend. Nothing to configure here.
# ---------------------------------------------------------------------------
