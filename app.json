{
  "expo": {
    "name": "Bytari",
    "slug": "bytari-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bytari",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#0BAA55",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bytari.mobile",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.bytari.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم بيطري صور جهازك لإضافة صور لحيواناتك وملفك الشخصي.",
          "cameraPermission": "يستخدم بيطري الكاميرا لالتقاط صور لحيواناتك وملفك الشخصي."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم بيطري موقعك لعرض أقرب العيادات البيطرية إليك."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "environment": "development"
    }
  }
}
